        <mxCell id="e-mcp" value="MCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0d32b2;fontSize=12;fontColor=#5b6b8c;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="web" target="llm">
