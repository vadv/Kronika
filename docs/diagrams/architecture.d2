# Kronika architecture. Regenerate the committed SVG with `make diagrams`.

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

host: Monitored Linux host {
  pg: PostgreSQL {width: 170}
  pgb: PgBouncer {width: 170}
  os: Linux kernel\n/proc, /sys {width: 170}

  collector: kronika-collector\nalways on {
    style.stroke-width: 3
  }

  pg -> collector: metrics + logs\nKRONIKA_PG_DSNS
  pgb -> collector: logs\nKRONIKA_PGBOUNCER_DSNS
  os -> collector: metrics

  dir: KRONIKA_OUT_DIR\nPOSIX directory — the only storage today {
    wal: active.wal\nwhat is being recorded now {
      shape: page
    }
    seg: YYYY/MM/DD/N.zms\nself-contained: needs no other file {
      shape: page
      style.multiple: true
    }
    wal -> seg: closed by size or age
  }

  collector -> dir.wal: appends

  web: kronika-web\non demand · read-only\nlistens on KRONIKA_WEB_LISTEN {
    style.stroke-width: 3
  }

  dir -> web: reads
}

people: People {
  shape: person
}
llm: LLM clients\nClaude Code · Codex · Cursor

host.web -> people: Web UI
host.web -> llm: MCP
