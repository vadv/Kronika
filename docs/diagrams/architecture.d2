# Kronika architecture. Regenerate the committed SVG with `make diagrams`.

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

pg: PostgreSQL\nqueries + log {width: 170}
pgb: PgBouncer\nlog events {width: 170}
os: OS\n/proc, /sys {width: 170}

collector: kronika-collector {
  style.stroke-width: 3
}

pg -> collector
pgb -> collector
os -> collector

storage: KRONIKA_OUT_DIR {
  wal: active.wal\nappend-only journal
  segment: YYYY/MM/DD/N.zms\nstring dictionary + typed rows
  wal -> segment: write_segment()
}

collector -> storage.wal: appends windows

web: kronika-web {
  style.stroke-width: 3
  ui: Web UI
  mcp: MCP
}

storage -> web: kronika-reader

browser: Browser
llm: LLM clients\nClaude Code, Codex, Cursor

web.ui -> browser
web.mcp -> llm
