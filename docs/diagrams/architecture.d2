# Kronika architecture. Regenerate the committed SVG with `make diagrams`.

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

classes: {
  kronika-binary: {
    style: {
      fill: "#c2d0f7"
      stroke: "#0d32b2"
      stroke-width: 3
    }
  }
  invisible: {
    style: {
      stroke-width: 0
      fill: transparent
    }
  }
}

root: "" {
  class: invisible
  grid-columns: 2
  grid-gap: 120

  host: Monitored Linux host {
    grid-columns: 2
    grid-gap: 100

    lane: "" {
      class: invisible

      pg: PostgreSQL {width: 170}
      pgb: PgBouncer {width: 170}
      os: OS\n/proc, /sys {width: 170}

      collector: kronika-collector {
        class: kronika-binary
      }

      pg -> collector: metrics + logs\nKRONIKA_PG_DSNS
      pgb -> collector: logs\nKRONIKA_PGBOUNCER_DSNS
      os -> collector: metrics

      dir: KRONIKA_OUT_DIR\nPOSIX directory — the only storage today {
        shape: cylinder

        wal: active.wal\nwhat is being recorded now {
          shape: page
        }

        seg: YYYY/MM/DD/N.zms — compressed, self-contained segments {
          style.multiple: true
          rows: typed rows\nParquet {
            shape: page
          }
          dict: shared text dictionary\nzstd {
            shape: page
          }
          rows -> dict: text by id
        }

        idx: YYYY/MM/DD/N.idx\nderived indexes, rebuilt by web {
          shape: page
          style.multiple: true
        }

        wal -> seg: closed by size or age
        seg -> idx: summaries
      }

      collector -> dir.wal: appends
    }

    webcol: "" {
      class: invisible
      web: kronika-web\nKRONIKA_WEB_LISTEN {
        class: kronika-binary
        width: 260
      }
    }

    lane.dir.seg -> webcol.web: reads
    webcol.web -> lane.dir.idx: builds, rebuilds
  }

  clients: "" {
    class: invisible
    grid-columns: 1
    grid-gap: 60
    browser: Browser {width: 250}
    llm: LLM client\nClaude Code · Codex · Cursor {width: 250}
  }

  host.webcol.web -> clients.browser: Web UI
  host.webcol.web -> clients.llm: MCP
}
