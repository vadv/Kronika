# syntax=docker/dockerfile:1.7

# Two layers on purpose, same reasoning as Dockerfile.bdd: the dependency
# layer is keyed on the manifests and the lockfile alone, so a source-only
# change reuses it and the image does not rebuild the crates.io graph on
# every run.
ARG DEMO_BASE=docker.io/library/rust:1.96.0-slim-bookworm

FROM ${DEMO_BASE} AS deps
# PostgreSQL and PgBouncer run inside the demo container itself, so they are
# installed here, in the layer keyed on the manifests, and not reinstalled on
# a source change. The PostgreSQL package also creates the `postgres` user
# the server tools require.
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql pgbouncer \
    && rm -rf /var/lib/apt/lists/*
# .cargo/config.toml pins musl for release binaries; the image has no musl
# std, so everything here builds for the host gnu target instead.
ENV CARGO_BUILD_TARGET=x86_64-unknown-linux-gnu
WORKDIR /work
COPY Cargo.toml Cargo.lock clippy.toml rustfmt.toml ./
COPY crates/kronika-layout/Cargo.toml crates/kronika-layout/
COPY crates/kronika-format/Cargo.toml crates/kronika-format/
COPY crates/kronika-derive/Cargo.toml crates/kronika-derive/
COPY crates/kronika-registry/Cargo.toml crates/kronika-registry/
COPY crates/kronika-writer/Cargo.toml crates/kronika-writer/
COPY crates/kronika-store/Cargo.toml crates/kronika-store/
COPY crates/kronika-reader/Cargo.toml crates/kronika-reader/
COPY crates/kronika-source-os/Cargo.toml crates/kronika-source-os/
COPY crates/kronika-source-log/Cargo.toml crates/kronika-source-log/
COPY crates/kronika-source-pg/Cargo.toml crates/kronika-source-pg/
COPY crates/kronika-index/Cargo.toml crates/kronika-index/
COPY crates/kronika-bdd/Cargo.toml crates/kronika-bdd/
COPY bins/kronika-collector/Cargo.toml bins/kronika-collector/
COPY bins/kronika-dump/Cargo.toml bins/kronika-dump/
COPY bins/kronika-demo/Cargo.toml bins/kronika-demo/
COPY bins/kronika-web/Cargo.toml bins/kronika-web/
# Placeholder sources let cargo resolve and compile the dependency graph. A
# proc-macro crate gets no bin target: cargo rejects one.
RUN set -eu; \
    for crate in crates/* bins/*; do \
        mkdir -p "$crate/src"; \
        : > "$crate/src/lib.rs"; \
        grep -q 'proc-macro = true' "$crate/Cargo.toml" \
            || echo 'fn main() {}' > "$crate/src/main.rs"; \
    done; \
    cargo build --workspace --locked --release; \
    rm -rf crates/*/src bins/*/src; \
    find target -name 'kronika*' -o -name 'libkronika*' | xargs -r rm -rf

FROM deps AS demo
WORKDIR /work
COPY . .
RUN cargo build --locked --release -p kronika-collector -p kronika-web -p kronika-demo
RUN install -m 0755 target/x86_64-unknown-linux-gnu/release/kronika-collector /usr/local/bin/ \
    && install -m 0755 target/x86_64-unknown-linux-gnu/release/kronika-web /usr/local/bin/ \
    && install -m 0755 target/x86_64-unknown-linux-gnu/release/kronika-demo /usr/local/bin/ \
    && install -m 0755 scripts/demo-entrypoint.sh /usr/local/bin/demo-entrypoint.sh \
    && rm -rf /work/target
VOLUME ["/var/lib/kronika/data"]
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/demo-entrypoint.sh"]
