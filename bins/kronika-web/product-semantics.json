      "origin": "accepted_presentation",
      "unit": null,
      "formula": null,
      "operands": ["state"],
      "thresholds": [],
      "expected_band": null,
      "policy": {
        "kind": "text_value_tone",
        "field": "state",
        "values": {
          "idle in transaction (aborted)": "critical",
          "idle in transaction": "warning",
          "R": "good",
          "D": "warning",
          "Z": "critical",
          "I": "inactive"
        },
        "ascii_values": true,
        "nonempty_tone": null
      }
    },
