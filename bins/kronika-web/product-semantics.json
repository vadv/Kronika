    {
      "id": "value_tone.mean_exec_ms_per_call",
      "origin": "accepted_presentation",
      "unit": "milliseconds_per_call",
      "formula": "execution_ms_per_second / calls_per_second",
      "operands": ["execution_ms_per_second", "calls_per_second"],
      "thresholds": [
        { "operator": "gte", "value": 5000, "tone": "critical" }
      ],
      "expected_band": { "min_inclusive": null, "max_exclusive": 5000 },
      "policy": { "kind": "numeric_value_tone", "field": "mean_exec_ms_per_call", "active_client_only": false }
    },
    {
      "id": "value_tone.mean_exec_time_ms",
      "origin": "accepted_presentation",
      "unit": "milliseconds",
      "formula": null,
      "operands": ["mean_exec_time_ms"],
      "thresholds": [
        { "operator": "gte", "value": 5000, "tone": "critical" }
      ],
      "expected_band": { "min_inclusive": null, "max_exclusive": 5000 },
      "policy": { "kind": "numeric_value_tone", "field": "mean_exec_time_ms", "active_client_only": false }
    },
    {
      "id": "value_tone.query_duration_ms",
      "origin": "accepted_presentation",
      "unit": "milliseconds",
      "formula": "(sample_timestamp - query_start) / 1000",
      "operands": ["sample_timestamp", "query_start", "backend_type", "state"],
      "thresholds": [
        { "operator": "gte", "value": 5000, "tone": "critical" },
        { "operator": "gte", "value": 1000, "tone": "warning" }
      ],
      "expected_band": { "min_inclusive": null, "max_exclusive": 1000 },
      "policy": { "kind": "numeric_value_tone", "field": "query_duration_ms", "active_client_only": true }
    },
    {
      "id": "value_tone.transaction_duration_ms",
      "origin": "accepted_presentation",
      "unit": "milliseconds",
      "formula": "(sample_timestamp - xact_start) / 1000",
      "operands": ["sample_timestamp", "xact_start", "backend_type", "state"],
      "thresholds": [
        { "operator": "gte", "value": 60000, "tone": "critical" },
        { "operator": "gte", "value": 5000, "tone": "warning" }
      ],
      "expected_band": { "min_inclusive": null, "max_exclusive": 5000 },
      "policy": { "kind": "numeric_value_tone", "field": "transaction_duration_ms", "active_client_only": true }
    },
    {
      "id": "value_tone.hit_pct",
      "origin": "accepted_presentation",
      "unit": "percent",
      "formula": "100 * shared_blks_hit / (shared_blks_hit + shared_blks_read)",
      "operands": ["shared_blks_hit", "shared_blks_read"],
      "thresholds": [
        { "operator": "lt", "value": 90, "tone": "critical" },
        { "operator": "lt", "value": 99, "tone": "warning" },
        { "operator": "gte", "value": 99, "tone": "good" }
      ],
      "expected_band": { "min_inclusive": 99, "max_exclusive": null },
      "policy": { "kind": "numeric_value_tone", "field": "hit_pct", "active_client_only": false }
    },
    {
      "id": "value_tone.cv",
      "origin": "accepted_presentation",
      "unit": null,
      "formula": "stddev_exec_time_ms / mean_exec_time_ms",
      "operands": ["stddev_exec_time_ms", "mean_exec_time_ms"],
      "thresholds": [
        { "operator": "lt", "value": 1, "tone": "good" },
        { "operator": "lt", "value": 3, "tone": "warning" },
        { "operator": "gte", "value": 3, "tone": "critical" }
      ],
      "expected_band": { "min_inclusive": null, "max_exclusive": 1 },
      "policy": { "kind": "numeric_value_tone", "field": "cv", "active_client_only": false }
    },
    {
      "id": "value_tone.plan_time_pct",
      "origin": "accepted_presentation",
      "unit": "percent",
      "formula": "100 * planning_ms_per_second / (planning_ms_per_second + execution_ms_per_second)",
      "operands": ["planning_ms_per_second", "execution_ms_per_second"],
      "thresholds": [
        { "operator": "lt", "value": 50, "tone": "good" },
        { "operator": "lt", "value": 80, "tone": "warning" },
        { "operator": "gte", "value": 80, "tone": "critical" }
      ],
      "expected_band": { "min_inclusive": null, "max_exclusive": 50 },
      "policy": { "kind": "numeric_value_tone", "field": "plan_time_pct", "active_client_only": false }
    },
    {
      "id": "value_tone.cpu_percent",
      "origin": "accepted_presentation",
      "unit": "percent",
      "formula": "100 * cpu_ticks / ticks_per_second / interval_seconds",
      "operands": ["utime", "stime", "ticks_per_second", "interval_seconds"],
      "thresholds": [
        { "operator": "gte", "value": 90, "tone": "critical" },
        { "operator": "gte", "value": 50, "tone": "warning" }
      ],
      "expected_band": { "min_inclusive": null, "max_exclusive": 50 },
      "policy": { "kind": "numeric_value_tone", "field": "cpu_percent", "active_client_only": false }
    },
